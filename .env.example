DATABASE_URL="postgresql://user:password@localhost:5432/pipeforge?schema=public"
NEXTAUTH_SECRET="change-me-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"
FASTAPI_URL="http://localhost:8000"
# Must match INTERNAL_API_SECRET in backend/.env (or the backend's env vars).
# Without this, anyone who finds the FastAPI URL could call /run directly
# with plan="pro" and bypass every quota/tier check the Next.js layer does.
INTERNAL_API_SECRET="change-me-to-a-random-string-shared-with-backend"
